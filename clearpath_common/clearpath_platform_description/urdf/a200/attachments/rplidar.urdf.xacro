<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- RPLidar macro -->
  <xacro:macro name="rplidar" params="
      name
      parent_link:=base_link
      xyz:='0 0 0'
      rpy:='0 0 0'
      laser_rpy:='0 0 0'
    ">

    <!-- Lidar body -->
    <link name="${name}_link">

      <visual>
        <origin xyz="0 0 0.0085" rpy="0 0 0"/>
        <geometry>
          <box size="0.080 0.087 0.017"/>
        </geometry>
        <material name="support">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>

      <visual>
        <origin xyz="0 0 0.034" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.041"/>
        </geometry>
        <material name="lidar">
          <color rgba="1.0 0.0 0.0 0.7"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.0085" rpy="0 0 0"/>
        <geometry>
          <box size="0.080 0.087 0.017"/>
        </geometry>
      </collision>

      <collision>
        <origin xyz="0 0 0.034" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.041"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0.02"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>

    </link>

    <!-- Mount lidar to robot -->
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
    </joint>

    <!-- Laser frame -->
    <link name="${name}_laser_frame"/>

    <joint name="${name}_laser_joint" type="fixed">
      <origin xyz="0 0 0.034" rpy="${laser_rpy}"/>
      <parent link="${name}_link"/>
      <child link="${name}_laser_frame"/>
    </joint>

  </xacro:macro>

</robot>