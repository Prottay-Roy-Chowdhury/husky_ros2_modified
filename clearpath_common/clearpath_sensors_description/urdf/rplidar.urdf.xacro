<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rplidar" params="name parent_link *origin
                                      ang_res:=1.0 min_ang:=-3.141592653589793 max_ang:=3.141592653589793
                                      update_rate:=10 min_range:=0.12 max_range:=12.0">

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0.0085" rpy="0 0 0"/>
        <geometry>
          <box size="0.080 0.087 0.017"/>
        </geometry>
        <material name="support">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>

      <visual>
        <origin xyz="0 0 0.034" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.041"/>
        </geometry>
        <material name="lidar">
          <color rgba="1.0 0.0 0.0 0.7"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.0085" rpy="0 0 0"/>
        <geometry>
          <box size="0.080 0.087 0.017"/>
        </geometry>
      </collision>

      <collision>
        <origin xyz="0 0 0.034" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.041"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <inertia
          ixx="0.0001" ixy="0.0" ixz="0.0"
          iyy="0.0001" iyz="0.0"
          izz="0.0001"/>
      </inertial>
    </link>

    <link name="${name}_laser"/>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}" />
      <child link="${name}_link" />
      <xacro:insert_block name="origin"/>
    </joint>

    <joint name="${name}_laser_joint" type="fixed">
      <parent link="${name}_link" />
      <child link="${name}_laser" />
      <origin xyz="0 0 0.034" rpy="0 0 3.141592653589793"/>
    </joint>

    <xacro:property name="samples" value="${round((max_ang - min_ang) * 180 / (ang_res * pi))}"/>

    <gazebo reference="${name}_laser">
      <sensor name="${name}" type="gpu_lidar">
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <always_on>true</always_on>
        <topic>$(arg namespace)/sensors/${name}/scan</topic>
        <ignition_frame_id>${name}_laser</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${min_ang}</min_angle>
              <max_angle>${max_ang}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>